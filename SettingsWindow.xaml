<Window x:Class="DekapuAutoOpencv.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Width="440" Height="580"
        MinWidth="380" MinHeight="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"    Value="#CCCCCC"/>
            <Setter Property="BorderBrush"   Value="#444"/>
            <Setter Property="Margin"        Value="0,0,0,10"/>
            <Setter Property="Padding"       Value="8,4,8,8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#BBBBBB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize"          Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"        Value="#2D2D2D"/>
            <Setter Property="Foreground"        Value="#EEEEEE"/>
            <Setter Property="BorderBrush"       Value="#555"/>
            <Setter Property="Padding"           Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height"            Value="26"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"        Value="#BBBBBB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background"    Value="#3C3C3C"/>
            <Setter Property="Foreground"    Value="#EEEEEE"/>
            <Setter Property="BorderBrush"   Value="#555"/>
            <Setter Property="Padding"       Value="16,4"/>
            <Setter Property="Height"        Value="30"/>
            <Setter Property="Cursor"        Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── スクロール可能な設定フォーム ── -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,12,16,4">
            <StackPanel>

                <!-- 動作設定 -->
                <GroupBox Header="動作設定">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ウィンドウ幅 (px)"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding WindowWidth}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ウィンドウ高さ (px)"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding WindowHeight}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ループ間隔 (ms)"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding LoopWaitMs}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="アイドル間隔 (ms)"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding IdleWaitMs}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="ドライラン"/>
                        <CheckBox  Grid.Row="4" Grid.Column="1" IsChecked="{Binding DryRun}"/>
                    </Grid>
                </GroupBox>

                <!-- 検知設定 -->
                <GroupBox Header="検知設定">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="二値化しきい値"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding ThresholdValue}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最小輪郭面積 (px²)"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding MinContourArea}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="膨張回数"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding DilateIterations}"/>
                    </Grid>
                </GroupBox>

                <!-- クリック設定 -->
                <GroupBox Header="クリック設定">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最小クリック距離 (px)"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding MinClickDistance}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="1ループ最大クリック数"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding MaxClicksPerLoop}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="輪郭ごとの乱数試行数"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding RandomClicksPerContour}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="近接クリック回避"/>
                        <CheckBox  Grid.Row="3" Grid.Column="1" IsChecked="{Binding EnableAvoidCloseClick}"/>
                    </Grid>
                </GroupBox>

                <!-- 入力設定 -->
                <GroupBox Header="入力設定">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="視点取得待機 (ms)"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding MouseTakeWaitMs}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="移動後待機 (ms)"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding MoveAfterWaitMs}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="クリック保持時間 (ms)"/>
                        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding ClickDownWaitMs}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="移動量除数"/>
                        <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding MouseMoveDivisor}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="FOV 抑制係数"/>
                        <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding FovSuppressionFactor}"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- ── ボタン行 ── -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16,8,16,12">
            <Button Content="保存"
                    Command="{Binding SaveCommand}"
                    Width="90"
                    Margin="0,0,8,0"/>
            <Button Content="キャンセル"
                    Command="{Binding CancelCommand}"
                    Width="90"/>
        </StackPanel>
    </Grid>
</Window>
