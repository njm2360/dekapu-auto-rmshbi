<Window x:Class="DekapuAutoOpencv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DekapuAutoOpencv"
        Width="480" SizeToContent="Height"
        MinWidth="480"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Status row -->
            <RowDefinition Height="Auto"/>
            <!-- Window info -->
            <RowDefinition Height="Auto"/>
            <!-- Separator -->
            <RowDefinition Height="8"/>
            <!-- Thumbnail area: 448px content width × 3/4 = 336px (4:3) -->
            <RowDefinition Height="336"/>
        </Grid.RowDefinitions>

        <!-- ── Status + 設定ボタン ── -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Ellipse Width="12" Height="12"
                         Fill="{Binding StatusColor}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#EEEEEE"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="設定"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OpenSettings_Click"
                    Background="#2D2D2D"
                    Foreground="#AAAAAA"
                    BorderBrush="#444"
                    Padding="10,3"
                    FontSize="12"
                    Cursor="Hand"/>
        </Grid>

        <!-- ── Window info ── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Window: " Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding WindowTitle}"
                       Style="{StaticResource ValueStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="320"/>
        </StackPanel>

        <!-- ── Thumbnail area ── -->
        <Border Grid.Row="3"
                Background="#121212"
                BorderBrush="#333"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <TextBlock Text="認識待機中..."
                           Foreground="#444"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding ThumbnailPlaceholderVisibility}"/>
                <Image Source="{Binding ThumbnailImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Grid>
        </Border>
    </Grid>
</Window>
